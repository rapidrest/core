{
    "name": "@rapidrest/core",
    "version": "5.2.0",
    "description": "A collection of common utilities and core functionality for rapidly building RESTful applications.",
    "repository": "https://github.com/rapidrest/core.git",
    "author": "RapidREST <rapidrests@gmail.com>",
    "license": "MPL-2.0",
    "contributors": [
        "Jean-Philippe Steinmetz",
        "Arthur Thompson",
        "Thomas Buscaglia"
    ],
    "scripts": {
        "build": "yarn lint && rimraf dist && tsc",
        "lint": "eslint ./src ./test",
        "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
        "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
        "dependency-check": "yarn dlx depcheck \"$@\"",
        "test": "vitest run --coverage",
        "test:prod": "yarn lint && vitest run --coverage",
        "release": "rapidrest release"
    },
    "dependencies": {
        "form-data": "^4.0.6",
        "handlebars": "^4.7.9",
        "js-yaml": "^5.3.0",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "mkdirp": "^3.0.1",
        "triple-beam": "^1.4.1",
        "uuid": "^14.0.2",
        "validator": "^13.15.35"
    },
    "peerDependencies": {
        "axios": "1.x",
        "redis": "6.x",
        "reflect-metadata": "0.2.x",
        "winston": "3.x",
        "winston-transport": "4.x"
    },
    "devDependencies": {
        "@rapidrest/cli": "^1.0.1",
        "@slack/bolt": "^5.0.0",
        "@slack/web-api": "^8.0.0",
        "@types/eslint": "^9.6.1",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.2.0",
        "@types/nodemailer": "^8.0.1",
        "@types/semver": "^7",
        "@types/triple-beam": "^1.3.5",
        "@types/validator": "^13.15.10",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitest/coverage-v8": "^4.1.11",
        "axios": "^1.19.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^64.2.1",
        "mkdirp": "^3.0.1",
        "nconf": "^0.13.0",
        "nock": "^14.0.17",
        "nodemailer": "^9.0.5",
        "prettier": "^3.9.6",
        "redis": "^6.2.1",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "semver": "^7.8.5",
        "ts-node": "^10.9.2",
        "twilio": "^6.1.0",
        "typescript": "^6.0.3",
        "undici": "^7.29.0",
        "vitest": "^4.1.11",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0"
    },
    "resolutions": {
        "cross-spawn": "^7.0.5"
    },
    "packageManager": "yarn@4.5.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "main": "dist/lib/index.js",
    "type": "module",
    "typings": "dist/types/index.d.ts",
    "files": [
        "dist"
    ]
}
